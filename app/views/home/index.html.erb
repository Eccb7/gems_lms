              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-blue-600 mb-2 group-hover:text-blue-700 transition-colors">
          <%= Course.published.count %>+
        </div>
        <div class="text-gray-600 font-medium">Active Courses</div>
        <div class="text-sm text-gray-500 mt-1">High-quality content</div>
      </div>
      
      <div class="group text-center">
        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-1a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-green-600 mb-2 group-hover:text-green-700 transition-colors">
          <%= User.where(role: :student).count %>K+
        </div>
        <div class="text-gray-600 font-medium">Happy Students</div>
        <div class="text-sm text-gray-500 mt-1">Learning every day</div>
      </div>
      
      <div class="group text-center">
        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-yellow-500 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-purple-600 mb-2 group-hover:text-purple-700 transition-colors">
          <%= User.where(role: :instructor).count %>+
        </div>
        <div class="text-gray-600 font-medium">Expert Instructors</div>
        <div class="text-sm text-gray-500 mt-1">Industry professionals</div>
      </div>
      
      <div class="group text-center">
        <div class="relative">
          <div class="w-20 h-20 bg-gradient-to-r from-orange-500 to-red-500 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300 shadow-lg">
            <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-purple-500 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-orange-600 mb-2 group-hover:text-orange-700 transition-colors">
          <%= Category.count %>+
        </div>
        <div class="text-gray-600 font-medium">Course Categories</div>
        <div class="text-sm text-gray-500 mt-1">Diverse subjects</div>
      </div>
    </div>
    
    <!-- Achievement badges -->
    <div class="mt-16 flex flex-wrap justify-center gap-6">
      <div class="flex items-center space-x-2 bg-blue-50 px-4 py-2 rounded-full">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="text-blue-800 font-medium">ISO Certified</span>
      </div>
      <div class="flex items-center space-x-2 bg-green-50 px-4 py-2 rounded-full">
        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
        <span class="text-green-800 font-medium">4.9/5 Rating</span>
      </div>
      <div class="flex items-center space-x-2 bg-purple-50 px-4 py-2 rounded-full">
        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
        </svg>
        <span class="text-purple-800 font-medium">GDPR Compliant</span>
      </div>
    </div>
  </div>
</section>

<!-- Featured Courses -->
<section class="py-20 bg-gradient-to-br from-gray-50 to-blue-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-800 rounded-full text-sm font-medium mb-4">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        Most Popular
      </div>
      <h2 class="text-4xl font-bold text-gray-900 mb-6">Featured Courses</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Discover our most popular courses taught by expert instructors and loved by thousands of students
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% Course.published.includes(:instructor, :category).limit(6).each_with_index do |course, index| %>
        <div class="group bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100">
          <!-- Course Image -->
          <div class="relative h-48 bg-gradient-to-br from-blue-500 via-purple-500 to-indigo-600 overflow-hidden">
            <!-- Animated background pattern -->
            <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="%23ffffff" fill-opacity="0.1"%3E%3Cpath d="M20 20c0 8.837-7.163 16-16 16s-16-7.163-16-16 7.163-16 16-16 16 7.163 16 16zm0 0c0-8.837 7.163-16 16-16s16 7.163 16 16-7.163 16-16 16-16-7.163-16-16z"/%3E%3C/g%3E%3C/svg%3E')] opacity-20"></div>
            
            <div class="relative h-full flex items-center justify-center">
              <div class="text-center">
                <div class="w-16 h-16 bg-white bg-opacity-20 rounded-2xl flex items-center justify-center mb-3 mx-auto backdrop-blur-sm border border-white border-opacity-30">
                  <span class="text-white text-xl font-bold"><%= course.title.first(2).upcase %></span>
                </div>
                <div class="text-white text-sm font-medium opacity-80">
                  <%= course.difficulty_level.humanize %> Level
                </div>
              </div>
            </div>
            
            <!-- Popular badge -->
            <% if index < 3 %>
              <div class="absolute top-4 left-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-xs font-bold flex items-center space-x-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
                <span>Popular</span>
              </div>
            <% end %>
            
            <!-- Category -->
            <div class="absolute top-4 right-4 bg-white bg-opacity-90 text-blue-600 px-3 py-1 rounded-full text-xs font-semibold backdrop-blur-sm">
              <%= course.category.name %>
            </div>
          </div>
          
          <!-- Course Content -->
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center space-x-2 text-sm text-gray-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span>6 weeks</span>
              </div>
              <div class="flex items-center space-x-1">
                <div class="flex text-yellow-400">
                  <% 5.times do %>
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                  <% end %>
                </div>
                <span class="text-sm text-gray-600 ml-1">4.9</span>
              </div>
            </div>
            
            <h3 class="text-xl font-bold mb-3 group-hover:text-blue-600 transition-colors">
              <%= link_to course.title, course_path(course), class: "line-clamp-2" %>
            </h3>
            
            <p class="text-gray-600 mb-4 line-clamp-2 text-sm leading-relaxed">
              <%= course.description %>
            </p>
            
            <!-- Instructor -->
            <div class="flex items-center mb-4 pb-4 border-b border-gray-100">
              <div class="w-8 h-8 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full flex items-center justify-center mr-3">
                <span class="text-white text-sm font-semibold">
                  <%= course.instructor.display_name.first.upcase %>
                </span>
              </div>
              <div>
                <div class="text-sm font-medium text-gray-900">
                  <%= course.instructor.display_name %>
                </div>
                <div class="text-xs text-gray-500">Expert Instructor</div>
              </div>
            </div>
            
            <!-- Course Stats -->
            <div class="flex items-center justify-between mb-4 text-sm text-gray-600">
              <div class="flex items-center space-x-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-1a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span><%= rand(500..2000) %> students</span>
              </div>
              <div class="flex items-center space-x-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
                <span><%= rand(10..25) %> lessons</span>
              </div>
            </div>
            
            <!-- Price and CTA -->
            <div class="flex items-center justify-between">
              <div>
                <% if course.price > 0 %>
                  <div class="text-2xl font-bold text-green-600">
                    $<%= course.price %>
                  </div>
                  <div class="text-sm text-gray-500 line-through">
                    $<%= (course.price * 1.5).round %>
                  </div>
                <% else %>
                  <div class="text-2xl font-bold text-green-600">Free</div>
                  <div class="text-sm text-gray-500">Limited time</div>
                <% end %>
              </div>
              <%= link_to course_path(course), class: "group flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm font-semibold rounded-xl hover:from-blue-700 hover:to-purple-700 transition-all transform hover:scale-105 shadow-md hover:shadow-lg" do %>
                <span>View Course</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="text-center mt-16">
      <%= link_to courses_path, class: "group inline-flex items-center space-x-3 px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-purple-700 transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        <span>Explore All Courses</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      <% end %>
    </div>
  </div>
</section>

<!-- Categories -->
<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <div class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-800 rounded-full text-sm font-medium mb-4">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        Browse by Category
      </div>
      <h2 class="text-4xl font-bold text-gray-900 mb-6">Explore Course Categories</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Find the perfect course in your area of interest and start your learning journey today
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% Category.includes(:courses).each_with_index do |category, index| %>
        <% 
          colors = [
            { bg: 'from-blue-500 to-blue-600', hover: 'hover:from-blue-600 hover:to-blue-700', icon: 'text-blue-600', card: 'hover:border-blue-200' },
            { bg: 'from-green-500 to-emerald-600', hover: 'hover:from-green-600 hover:to-emerald-700', icon: 'text-green-600', card: 'hover:border-green-200' },
            { bg: 'from-purple-500 to-purple-600', hover: 'hover:from-purple-600 hover:to-purple-700', icon: 'text-purple-600', card: 'hover:border-purple-200' },
            { bg: 'from-orange-500 to-red-500', hover: 'hover:from-orange-600 hover:to-red-600', icon: 'text-orange-600', card: 'hover:border-orange-200' },
            { bg: 'from-pink-500 to-rose-500', hover: 'hover:from-pink-600 hover:to-rose-600', icon: 'text-pink-600', card: 'hover:border-pink-200' },
            { bg: 'from-indigo-500 to-indigo-600', hover: 'hover:from-indigo-600 hover:to-indigo-700', icon: 'text-indigo-600', card: 'hover:border-indigo-200' }
          ]
          color = colors[index % colors.length]
        %>
        
        <div class="group relative">
          <%= link_to category_path(category), class: "block" do %>
            <div class="bg-white rounded-2xl p-6 shadow-lg border-2 border-transparent transition-all duration-300 transform hover:-translate-y-2 hover:shadow-xl <%= color[:card] %>">
              <div class="flex items-center space-x-4 mb-4">
                <div class="w-16 h-16 bg-gradient-to-r <%= color[:bg] %> rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 shadow-lg">
                  <% 
                    icons = {
                      'Programming' => 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
                      'Design' => 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z',
                      'Business' => 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
                      'Marketing' => 'M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z',
                      'Photography' => 'M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9zM15 13a3 3 0 11-6 0 3 3 0 016 0z',
                      'Music' => 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z M21 16c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z M9 10l12-3'
                    }
                    icon_path = icons[category.name] || 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10'
                  %>
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon_path %>"></path>
                  </svg>
                </div>
                
                <div class="flex-1">
                  <h3 class="text-xl font-bold text-gray-900 group-hover:<%= color[:icon] %> transition-colors">
                    <%= category.name %>
                  </h3>
                  <p class="text-sm text-gray-600 mt-1">
                    <%= pluralize(category.courses.published.count, 'course') %> available
                  </p>
                </div>
                
                <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-6 h-6 <%= color[:icon] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
              
              <!-- Category features -->
              <div class="space-y-2">
                <div class="flex items-center text-sm text-gray-600">
                  <svg class="w-4 h-4 mr-2 <%= color[:icon] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-1a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span><%= rand(100..500) %>+ students enrolled</span>
                </div>
                <div class="flex items-center text-sm text-gray-600">
                  <svg class="w-4 h-4 mr-2 <%= color[:icon] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                  </svg>
                  <span>4.8+ average rating</span>
                </div>
                <div class="flex items-center text-sm text-gray-600">
                  <svg class="w-4 h-4 mr-2 <%= color[:icon] %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>Self-paced learning</span>
                </div>
              </div>
              
              <!-- Hover effect overlay -->
              <div class="absolute inset-0 bg-gradient-to-r <%= color[:bg] %> opacity-0 group-hover:opacity-5 transition-opacity rounded-2xl"></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    
    <!-- View all categories button -->
    <div class="text-center mt-12">
      <%= link_to categories_path, class: "group inline-flex items-center space-x-3 px-8 py-4 bg-gradient-to-r from-gray-900 to-gray-800 text-white font-semibold rounded-xl hover:from-gray-800 hover:to-gray-700 transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
        <span>View All Categories</span>
        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      <% end %>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="relative py-20 bg-gradient-to-br from-blue-600 via-purple-600 to-indigo-700 text-white overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.1"%3E%3Ccircle cx="7" cy="7" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30"></div>
  <div class="absolute top-10 left-10 w-32 h-32 bg-white bg-opacity-10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-10 right-10 w-40 h-40 bg-yellow-300 bg-opacity-20 rounded-full blur-3xl"></div>
  
  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <div class="mb-8">
      <div class="inline-flex items-center px-6 py-3 bg-white bg-opacity-20 rounded-full text-lg font-medium mb-6 backdrop-blur-sm border border-white border-opacity-30">
        <svg class="w-6 h-6 mr-3 text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
        Join the Learning Revolution
      </div>
    </div>
    
    <h2 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent">
      Ready to Start Your
      <span class="block text-yellow-300">Learning Journey?</span>
    </h2>
    
    <p class="text-xl md:text-2xl mb-12 max-w-3xl mx-auto leading-relaxed text-blue-100">
      Join thousands of students already transforming their careers and lives with GEMS LMS. Start learning today with our expert-led courses.
    </p>
    
    <% unless user_signed_in? %>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
        <%= link_to new_user_registration_path, class: "group flex items-center space-x-3 px-8 py-4 bg-white text-blue-600 font-bold rounded-xl hover:bg-blue-50 transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl" do %>
          <svg class="w-6 h-6 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
          </svg>
          <span>Start Learning Free</span>
        <% end %>
        
        <%= link_to "#", class: "group flex items-center space-x-3 px-8 py-4 border-2 border-white text-white font-semibold rounded-xl hover:bg-white hover:text-blue-600 transition-all transform hover:scale-105 backdrop-blur-sm" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Learn More</span>
        <% end %>
      </div>
      
      <!-- Trust indicators -->
      <div class="flex flex-wrap justify-center items-center gap-8 text-sm text-blue-200">
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>No Credit Card Required</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span>30-Day Money Back Guarantee</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span>Instant Access to All Courses</span>
        </div>
      </div>
    <% else %>
      <div class="text-center">
        <p class="text-2xl font-semibold mb-6">Welcome back! Continue your learning journey.</p>
        <%= link_to student_dashboard_path, class: "group inline-flex items-center space-x-3 px-8 py-4 bg-white text-blue-600 font-bold rounded-xl hover:bg-blue-50 transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl" do %>
          <svg class="w-6 h-6 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <span>Go to Dashboard</span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
