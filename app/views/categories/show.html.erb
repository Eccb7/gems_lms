<% content_for :title, "#{@category.name} Courses - GEMS LMS" %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- Breadcrumb -->
  <nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
      <li class="inline-flex items-center">
        <%= link_to root_path, class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600" do %>
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
          </svg>
          Home
        <% end %>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
          <%= link_to "Categories", categories_path, class: "ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2" %>
        </div>
      </li>
      <li aria-current="page">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2"><%= @category.name %></span>
        </div>
      </li>
    </ol>
  </nav>

  <!-- Category Header -->
  <div class="bg-gradient-to-r from-blue-600 to-purple-700 text-white rounded-lg p-8 mb-8">
    <div class="flex items-center space-x-6">
      <div class="w-20 h-20 bg-white bg-opacity-20 rounded-2xl flex items-center justify-center">
        <span class="text-3xl font-bold"><%= @category.name.first(2).upcase %></span>
      </div>
      <div class="flex-1">
        <h1 class="text-4xl font-bold mb-2"><%= @category.name %></h1>
        <% if @category.description.present? %>
          <p class="text-lg text-blue-100 mb-4"><%= @category.description %></p>
        <% end %>
        <div class="flex items-center space-x-6 text-blue-100">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            <span><%= pluralize(@category.courses.published.count, 'course') %></span>
          </div>
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
            </svg>
            <span><%= Enrollment.joins(:course).where(courses: { category: @category }).count %> students</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <%= form_with url: category_path(@category), method: :get, local: true, class: "space-y-4" do |form| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Search -->
        <div class="md:col-span-2">
          <%= form.text_field :search, placeholder: "Search #{@category.name.downcase} courses...", 
                              value: params[:search],
                              class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" %>
        </div>
        
        <!-- Difficulty Filter -->
        <div>
          <%= form.select :difficulty, 
                          options_for_select(@difficulty_levels.map { |level| [level.humanize, level] }, params[:difficulty]),
                          { prompt: "All Levels" },
                          { class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
        
        <!-- Sort -->
        <div>
          <%= form.select :sort, 
                          options_for_select([
                            ['Latest', 'newest'],
                            ['Popular', 'popular'],
                            ['Price: Low to High', 'price_low'],
                            ['Price: High to Low', 'price_high']
                          ], params[:sort]),
                          { prompt: "Sort by" },
                          { class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
      </div>
      
      <div class="flex justify-between items-center">
        <div class="flex space-x-4">
          <!-- Price Filters -->
          <label class="flex items-center">
            <%= form.radio_button :price_filter, "free", checked: params[:price_filter] == "free" %>
            <span class="ml-2 text-sm text-gray-700">Free</span>
          </label>
          <label class="flex items-center">
            <%= form.radio_button :price_filter, "paid", checked: params[:price_filter] == "paid" %>
            <span class="ml-2 text-sm text-gray-700">Paid</span>
          </label>
        </div>
        
        <div class="flex space-x-2">
          <%= form.submit "Search", class: "px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
          <%= link_to "Clear", category_path(@category), class: "px-6 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Results Summary -->
  <div class="flex justify-between items-center mb-6">
    <p class="text-gray-600">
      <% if params[:search].present? || params[:difficulty].present? || params[:price_filter].present? %>
        Showing <%= @courses.count %> filtered results
      <% else %>
        Showing all <%= @courses.respond_to?(:total_count) ? @courses.total_count : @courses.count %> courses
      <% end %>
    </p>
  </div>

  <!-- Courses Grid -->
  <% if @courses.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-8">
      <% @courses.each do |course| %>
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-all duration-300">
          <!-- Course Image/Thumbnail -->
          <div class="h-48 bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center relative">
            <span class="text-white text-2xl font-semibold"><%= course.title.first(2).upcase %></span>
            
            <!-- Difficulty Badge -->
            <div class="absolute top-3 right-3">
              <span class="inline-block px-2 py-1 text-xs font-semibold text-white bg-black bg-opacity-30 rounded">
                <%= course.difficulty_level.humanize %>
              </span>
            </div>
          </div>
          
          <div class="p-6">
            <!-- Course Title -->
            <h3 class="text-xl font-semibold text-gray-900 mb-2 line-clamp-2">
              <%= link_to course.title, course_path(course), class: "hover:text-blue-600 transition-colors" %>
            </h3>
            
            <!-- Course Description -->
            <p class="text-gray-600 text-sm mb-4 line-clamp-3">
              <%= truncate(course.description, length: 120) %>
            </p>
            
            <!-- Instructor -->
            <div class="flex items-center mb-4">
              <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center mr-3">
                <span class="text-xs font-medium text-gray-600">
                  <%= course.instructor.display_name.first(2).upcase %>
                </span>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900"><%= course.instructor.display_name %></p>
                <p class="text-xs text-gray-500">Instructor</p>
              </div>
            </div>
            
            <!-- Course Stats -->
            <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
              <div class="flex items-center space-x-4">
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
                  </svg>
                  <%= course.enrollments.count %>
                </span>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= course.sections.joins(:lessons).count %> lessons
                </span>
              </div>
              <div class="flex items-center">
                <span class="text-yellow-500 mr-1">★</span>
                <span>4.8</span>
              </div>
            </div>
            
            <!-- Price and CTA -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-200">
              <div class="text-lg font-semibold">
                <% if course.price > 0 %>
                  <span class="text-green-600">$<%= course.price %></span>
                <% else %>
                  <span class="text-green-600">Free</span>
                <% end %>
              </div>
              
              <div class="flex space-x-2">
                <%= link_to "Preview", course_path(course), 
                           class: "px-3 py-2 text-sm text-blue-600 border border-blue-600 rounded-md hover:bg-blue-50 transition" %>
                
                <% if user_signed_in? && current_user.student? %>
                  <% if current_user.enrolled_in?(course) %>
                    <%= link_to "Continue", course_path(course), 
                               class: "px-3 py-2 text-sm bg-green-600 text-white rounded-md hover:bg-green-700 transition" %>
                  <% else %>
                    <%= link_to "Enroll", enroll_course_path(course), method: :post,
                               class: "px-3 py-2 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700 transition" %>
                  <% end %>
                <% else %>
                  <%= link_to "View Course", course_path(course), 
                             class: "px-3 py-2 text-sm bg-blue-600 text-white rounded-md hover:bg-blue-700 transition" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @courses.respond_to?(:current_page) %>
      <div class="flex justify-center">
        <%= paginate @courses %>
      </div>
    <% end %>
  <% else %>
    <!-- No Results -->
    <div class="text-center py-12">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No courses found</h3>
      <p class="mt-1 text-sm text-gray-500">
        <% if params[:search].present? || params[:difficulty].present? || params[:price_filter].present? %>
          Try adjusting your search criteria or filters.
        <% else %>
          No courses available in this category yet.
        <% end %>
      </p>
      <div class="mt-6">
        <%= link_to "Browse All Courses", courses_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
      </div>
    </div>
  <% end %>

  <!-- Related Categories -->
  <div class="mt-12 bg-gray-50 rounded-lg p-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Explore Other Categories</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <% Category.where.not(id: @category.id).limit(4).each do |category| %>
        <%= link_to category_path(category), class: "flex items-center p-4 bg-white rounded-lg hover:shadow-md transition" do %>
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
            <span class="text-blue-600 font-semibold"><%= category.name.first(2).upcase %></span>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900"><%= category.name %></h3>
            <p class="text-sm text-gray-600"><%= pluralize(category.courses.published.count, 'course') %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
