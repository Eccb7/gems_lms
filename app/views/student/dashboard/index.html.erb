<% content_for :title, "Student Dashboard - GEMS LMS" %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Welcome back, <%= current_user.display_name %>!</h1>
    <p class="text-gray-600 mt-2">Continue your learning journey</p>
  </div>

  <!-- Progress Overview -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Enrolled Courses -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Enrolled Courses</dt>
            <dd class="text-2xl font-semibold text-gray-900"><%= current_user.enrollments.count %></dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Completed Courses -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Completed Courses</dt>
            <dd class="text-2xl font-semibold text-gray-900"><%= current_user.enrollments.where(completed: true).count %></dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Learning Streak -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 bg-orange-100 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Learning Streak</dt>
            <dd class="text-2xl font-semibold text-gray-900">7 days</dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Continue Learning -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
    <!-- In Progress Courses -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-lg shadow">
        <div class="p-6 border-b border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900">Continue Learning</h3>
        </div>
        <div class="p-6">
          <% enrolled_courses = current_user.enrollments.includes(course: [:instructor, :category]).where(completed: false).limit(3) %>
          <% if enrolled_courses.any? %>
            <div class="space-y-6">
              <% enrolled_courses.each do |enrollment| %>
                <% course = enrollment.course %>
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0">
                      <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
                        <span class="text-white font-semibold"><%= course.title.first(2).upcase %></span>
                      </div>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-lg font-semibold text-gray-900 mb-1"><%= course.title %></h4>
                      <p class="text-sm text-gray-600 mb-2">by <%= course.instructor.display_name %></p>
                      
                      <!-- Progress Bar -->
                      <div class="mb-3">
                        <div class="flex justify-between text-sm text-gray-600 mb-1">
                          <span>Progress</span>
                          <span><%= enrollment.progress_percentage %>%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                          <div class="bg-blue-600 h-2 rounded-full" style="width: <%= enrollment.progress_percentage %>%"></div>
                        </div>
                      </div>
                      
                      <div class="flex items-center justify-between">
                        <span class="text-sm text-gray-500">
                          Last accessed <%= time_ago_in_words(enrollment.last_accessed_at || enrollment.created_at) %> ago
                        </span>
                        <%= link_to "Continue", student_course_path(course), class: "px-4 py-2 bg-blue-600 text-white text-sm rounded-md hover:bg-blue-700" %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
            
            <% if current_user.enrollments.where(completed: false).count > 3 %>
              <div class="mt-6 pt-6 border-t text-center">
                <%= link_to "View All Courses", student_courses_path, class: "text-blue-600 hover:text-blue-800" %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-8">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">No courses in progress</h3>
              <p class="mt-1 text-sm text-gray-500">Get started by enrolling in a course.</p>
              <div class="mt-6">
                <%= link_to "Browse Courses", courses_path, class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Upcoming Deadlines -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Upcoming Deadlines</h3>
        <div class="space-y-3">
          <% Assignment.joins(lesson: { section: { course: :enrollments } })
                      .where(enrollments: { user: current_user })
                      .where('due_date > ?', Time.current)
                      .order(:due_date)
                      .limit(3)
                      .includes(lesson: { section: :course })
                      .each do |assignment| %>
            <div class="flex items-start space-x-3">
              <div class="flex-shrink-0 w-2 h-2 bg-red-400 rounded-full mt-2"></div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate"><%= assignment.title %></p>
                <p class="text-xs text-gray-500"><%= assignment.lesson.section.course.title %></p>
                <p class="text-xs text-red-600">Due <%= time_ago_in_words(assignment.due_date) %></p>
              </div>
            </div>
          <% end %>
          
          <% if Assignment.joins(lesson: { section: { course: :enrollments } })
                           .where(enrollments: { user: current_user })
                           .where('due_date > ?', Time.current).empty? %>
            <p class="text-sm text-gray-500">No upcoming deadlines</p>
          <% end %>
        </div>
      </div>

      <!-- Recent Achievements -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Recent Achievements</h3>
        <div class="space-y-3">
          <% current_user.enrollments.where(completed: true).order(completed_at: :desc).limit(3).each do |enrollment| %>
            <div class="flex items-center space-x-3">
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900">Completed Course</p>
                <p class="text-xs text-gray-500"><%= enrollment.course.title %></p>
              </div>
            </div>
          <% end %>
          
          <% if current_user.enrollments.where(completed: true).empty? %>
            <p class="text-sm text-gray-500">No achievements yet</p>
          <% end %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h3>
        <div class="space-y-2">
          <%= link_to courses_path, class: "flex items-center p-2 text-gray-700 hover:bg-gray-50 rounded-lg" do %>
            <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Browse Courses
          <% end %>
          
          <%= link_to student_courses_path, class: "flex items-center p-2 text-gray-700 hover:bg-gray-50 rounded-lg" do %>
            <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            My Courses
          <% end %>
          
          <%= link_to student_profile_path, class: "flex items-center p-2 text-gray-700 hover:bg-gray-50 rounded-lg" do %>
            <svg class="w-4 h-4 mr-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            My Profile
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recommended Courses -->
  <div class="bg-white rounded-lg shadow">
    <div class="p-6 border-b border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900">Recommended for You</h3>
    </div>
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% Course.published.where.not(id: current_user.enrollments.select(:course_id)).limit(3).each do |course| %>
          <div class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition">
            <div class="h-32 bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center">
              <span class="text-white text-xl font-semibold"><%= course.title.first(2).upcase %></span>
            </div>
            <div class="p-4">
              <div class="text-xs text-blue-600 mb-1"><%= course.category.name %></div>
              <h4 class="font-semibold text-gray-900 mb-2"><%= course.title %></h4>
              <p class="text-sm text-gray-600 mb-3 line-clamp-2"><%= truncate(course.description, length: 80) %></p>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-500">by <%= course.instructor.display_name %></span>
                <%= link_to "View Course", course_path(course), class: "px-3 py-1 bg-blue-600 text-white text-xs rounded-md hover:bg-blue-700" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
      <div class="mt-6 text-center">
        <%= link_to "View All Courses", courses_path, class: "text-blue-600 hover:text-blue-800" %>
      </div>
    </div>
  </div>
</div>
