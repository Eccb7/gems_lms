<% content_for :title, "Student Dashboard - GEMS LMS" %>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <!-- Header -->
    <div class="mb-8 sm:mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="flex items-center space-x-3 mb-2">
            <div class="w-12 h-12 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-2xl flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 14 6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold bg-gradient-to-r from-gray-900 to-gray-700 bg-clip-text text-transparent">
                Welcome back, <%= current_user.display_name %>!
              </h1>
              <p class="text-gray-600 text-sm sm:text-base lg:text-lg mt-1">Continue your learning journey with personalized courses</p>
            </div>
          </div>
        </div>
        
        <!-- Quick stats for mobile -->
        <div class="mt-4 sm:mt-0">
          <div class="flex items-center space-x-4 text-sm">
            <div class="flex items-center space-x-2 text-green-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              <span class="hidden sm:inline">Learning Active</span>
              <span class="sm:hidden">Active</span>
            </div>
            <div class="flex items-center space-x-2 text-blue-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="hidden sm:inline"><%= Time.current.strftime("%B %d, %Y") %></span>
              <span class="sm:hidden">Today</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Progress Overview -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8 sm:mb-12">
      <!-- Enrolled Courses -->
      <div class="group bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100">
        <div class="p-4 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>
            <div class="text-right">
              <div class="text-2xl sm:text-3xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                <%= current_user.enrollments.count %>
              </div>
              <div class="text-xs sm:text-sm text-green-600 font-medium">
                +<%= current_user.enrollments.where('created_at > ?', 1.week.ago).count %> this week
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-700">Enrolled Courses</h3>
            <p class="text-xs sm:text-sm text-gray-500">Active learning paths</p>
          </div>
        </div>
      </div>

      <!-- Completed Courses -->
      <div class="group bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100">
        <div class="p-4 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div class="text-right">
              <div class="text-2xl sm:text-3xl font-bold text-gray-900 group-hover:text-green-600 transition-colors">
                <%= current_user.enrollments.where(completed: true).count %>
              </div>
              <div class="text-xs sm:text-sm text-blue-600 font-medium">
                <% completion_rate = current_user.enrollments.count > 0 ? (current_user.enrollments.where(completed: true).count.to_f / current_user.enrollments.count * 100).round(1) : 0 %>
                <%= completion_rate %>% completion rate
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-700">Completed Courses</h3>
            <p class="text-xs sm:text-sm text-gray-500">Achievements earned</p>
          </div>
        </div>
      </div>

      <!-- Learning Streak -->
      <div class="group bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-gray-100 sm:col-span-2 lg:col-span-1">
        <div class="p-4 sm:p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-r from-orange-500 to-red-500 rounded-2xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path>
              </svg>
            </div>
            <div class="text-right">
              <div class="text-2xl sm:text-3xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors">
                7 days
              </div>
              <div class="text-xs sm:text-sm text-orange-600 font-medium animate-pulse">
                🔥 On fire!
              </div>
            </div>
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-semibold text-gray-700">Learning Streak</h3>
            <p class="text-xs sm:text-sm text-gray-500">Keep it going!</p>
          </div>
        </div>
      </div>
  </div>

    <!-- Continue Learning -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 sm:gap-8 mb-8 sm:mb-12">
      <!-- In Progress Courses -->
      <div class="xl:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
          <div class="p-4 sm:p-6 border-b border-gray-200">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-gray-900">Continue Learning</h3>
            </div>
          </div>
          <div class="p-4 sm:p-6">
            <% enrolled_courses = current_user.enrollments.includes(course: [:instructor, :category]).where(completed: false).limit(3) %>
            <% if enrolled_courses.any? %>
              <div class="space-y-4 sm:space-y-6">
                <% enrolled_courses.each do |enrollment| %>
                  <% course = enrollment.course %>
                  <div class="group border border-gray-200 rounded-xl p-4 sm:p-6 hover:shadow-lg hover:border-blue-200 transition-all duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-start space-y-4 sm:space-y-0 sm:space-x-4">
                      <div class="flex-shrink-0 mx-auto sm:mx-0">
                        <div class="w-16 h-16 sm:w-20 sm:h-20 bg-gradient-to-r from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                          <span class="text-white font-bold text-lg sm:text-xl"><%= course.title.first(2).upcase %></span>
                        </div>
                      </div>
                      <div class="flex-1 min-w-0 text-center sm:text-left">
                        <h4 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                          <%= course.title %>
                        </h4>
                        <div class="flex flex-col sm:flex-row sm:items-center sm:space-x-4 space-y-1 sm:space-y-0 mb-4">
                          <p class="text-sm text-gray-600 flex items-center justify-center sm:justify-start">
                            <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            by <%= course.instructor.display_name %>
                          </p>
                          <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            <%= course.category.name %>
                          </span>
                        </div>
                        
                        <!-- Progress Bar -->
                        <div class="mb-4">
                          <div class="flex justify-between text-sm text-gray-600 mb-2">
                            <span class="font-medium">Progress</span>
                            <span class="font-bold text-blue-600"><%= enrollment.progress_percentage %>%</span>
                          </div>
                          <div class="w-full bg-gray-200 rounded-full h-3">
                            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-3 rounded-full transition-all duration-500" style="width: <%= enrollment.progress_percentage %>%"></div>
                          </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0">
                          <span class="text-sm text-gray-500 flex items-center justify-center sm:justify-start">
                            <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Last accessed <%= time_ago_in_words(enrollment.last_accessed_at || enrollment.created_at) %> ago
                          </span>
                          <%= link_to student_course_path(course), class: "group flex items-center justify-center space-x-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white text-sm font-medium rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl" do %>
                            <span>Continue Learning</span>
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                            </svg>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              
              <% if current_user.enrollments.where(completed: false).count > 3 %>
                <div class="mt-6 pt-6 border-t border-gray-200 text-center">
                  <%= link_to student_courses_path, class: "inline-flex items-center space-x-2 text-blue-600 hover:text-blue-800 font-medium hover:bg-blue-50 px-4 py-2 rounded-lg transition-colors" do %>
                    <span>View All <%= current_user.enrollments.where(completed: false).count %> Courses</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-12">
                <div class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Ready to Start Learning?</h3>
                <p class="text-gray-500 mb-6 max-w-sm mx-auto">Discover amazing courses and start your learning journey today.</p>
                <div class="space-y-3 sm:space-y-0 sm:space-x-3 sm:flex sm:justify-center">
                  <%= link_to courses_path, class: "inline-flex items-center justify-center space-x-2 w-full sm:w-auto px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-medium rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all transform hover:scale-105 shadow-lg" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                    <span>Browse Courses</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Upcoming Deadlines -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
          <div class="p-4 sm:p-6">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-r from-red-500 to-pink-500 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Upcoming Deadlines</h3>
            </div>
            <div class="space-y-3">
              <% Assignment.joins(lesson: { section: { course: :enrollments } })
                          .where(enrollments: { user: current_user })
                          .where('due_date > ?', Time.current)
                          .order(:due_date)
                          .limit(3)
                          .includes(lesson: { section: :course })
                          .each do |assignment| %>
                <div class="group flex items-start space-x-3 p-3 rounded-xl hover:bg-red-50 transition-colors">
                  <div class="flex-shrink-0 w-3 h-3 bg-red-400 rounded-full mt-2 group-hover:bg-red-500 transition-colors"></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-900 truncate group-hover:text-red-700"><%= assignment.title %></p>
                    <p class="text-xs text-gray-500 flex items-center mt-1">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                      </svg>
                      <%= assignment.lesson.section.course.title %>
                    </p>
                    <p class="text-xs text-red-600 font-medium mt-1">
                      Due <%= time_ago_in_words(assignment.due_date) %>
                    </p>
                  </div>
                </div>
              <% end %>
              
              <% if Assignment.joins(lesson: { section: { course: :enrollments } })
                               .where(enrollments: { user: current_user })
                               .where('due_date > ?', Time.current).empty? %>
                <div class="text-center py-4">
                  <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-2">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <p class="text-sm text-gray-500">All caught up!</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Recent Achievements -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
          <div class="p-4 sm:p-6">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-r from-yellow-500 to-orange-500 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Recent Achievements</h3>
            </div>
            <div class="space-y-3">
              <% current_user.enrollments.where(completed: true).order(completed_at: :desc).limit(3).each do |enrollment| %>
                <div class="group flex items-center space-x-3 p-3 rounded-xl hover:bg-green-50 transition-colors">
                  <div class="flex-shrink-0">
                    <div class="w-8 h-8 bg-green-100 group-hover:bg-green-200 rounded-full flex items-center justify-center transition-colors">
                      <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-900 group-hover:text-green-700">Course Completed! 🎉</p>
                    <p class="text-xs text-gray-500 truncate"><%= enrollment.course.title %></p>
                  </div>
                </div>
              <% end %>
              
              <% if current_user.enrollments.where(completed: true).empty? %>
                <div class="text-center py-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-2">
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                  <p class="text-sm text-gray-500">Complete your first course!</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
          <div class="p-4 sm:p-6">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Quick Actions</h3>
            </div>
            <div class="space-y-2">
              <%= link_to courses_path, class: "group flex items-center p-3 text-gray-700 hover:bg-gradient-to-r hover:from-blue-50 hover:to-indigo-50 rounded-xl transition-all hover:text-blue-700 border border-transparent hover:border-blue-200" do %>
                <div class="w-8 h-8 bg-blue-100 group-hover:bg-blue-200 rounded-lg flex items-center justify-center mr-3 transition-colors">
                  <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-semibold text-sm">Browse Courses</div>
                  <div class="text-xs text-gray-500">Discover new learning</div>
                </div>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
              
              <%= link_to student_courses_path, class: "group flex items-center p-3 text-gray-700 hover:bg-gradient-to-r hover:from-green-50 hover:to-emerald-50 rounded-xl transition-all hover:text-green-700 border border-transparent hover:border-green-200" do %>
                <div class="w-8 h-8 bg-green-100 group-hover:bg-green-200 rounded-lg flex items-center justify-center mr-3 transition-colors">
                  <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-semibold text-sm">My Courses</div>
                  <div class="text-xs text-gray-500">View your progress</div>
                </div>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
              
              <%= link_to student_profile_path, class: "group flex items-center p-3 text-gray-700 hover:bg-gradient-to-r hover:from-purple-50 hover:to-pink-50 rounded-xl transition-all hover:text-purple-700 border border-transparent hover:border-purple-200" do %>
                <div class="w-8 h-8 bg-purple-100 group-hover:bg-purple-200 rounded-lg flex items-center justify-center mr-3 transition-colors">
                  <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                </div>
                <div class="flex-1">
                  <div class="font-semibold text-sm">My Profile</div>
                  <div class="text-xs text-gray-500">Account settings</div>
                </div>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recommended Courses -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100">
      <div class="p-4 sm:p-6 border-b border-gray-200">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-r from-pink-500 to-rose-500 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-gray-900">Recommended for You</h3>
        </div>
      </div>
      <div class="p-4 sm:p-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6">
          <% Course.published.where.not(id: current_user.enrollments.select(:course_id)).limit(3).each_with_index do |course, index| %>
            <% 
              gradient_classes = [
                'from-blue-500 to-purple-600',
                'from-green-500 to-teal-600', 
                'from-orange-500 to-red-600'
              ]
              gradient = gradient_classes[index % gradient_classes.length]
            %>
            <div class="group bg-white border border-gray-200 rounded-2xl overflow-hidden hover:shadow-xl hover:border-blue-200 transition-all duration-300 transform hover:-translate-y-1">
              <div class="h-40 sm:h-48 bg-gradient-to-r <%= gradient %> flex items-center justify-center relative overflow-hidden">
                <!-- Background pattern -->
                <div class="absolute inset-0 bg-white bg-opacity-10"></div>
                <div class="relative text-center">
                  <div class="w-16 h-16 bg-white bg-opacity-20 rounded-2xl flex items-center justify-center mb-3 mx-auto backdrop-blur-sm border border-white border-opacity-30">
                    <span class="text-white text-xl font-bold"><%= course.title.first(2).upcase %></span>
                  </div>
                  <div class="text-white text-sm font-medium opacity-80">
                    <%= course.difficulty_level.humanize %> Level
                  </div>
                </div>
                
                <!-- Category badge -->
                <div class="absolute top-3 left-3 bg-white bg-opacity-90 backdrop-blur-sm text-gray-700 px-2 py-1 rounded-full text-xs font-semibold">
                  <%= course.category.name %>
                </div>
              </div>
              
              <div class="p-4 sm:p-6">
                <h4 class="font-bold text-gray-900 mb-3 text-lg group-hover:text-blue-600 transition-colors line-clamp-2">
                  <%= course.title %>
                </h4>
                <p class="text-sm text-gray-600 mb-4 line-clamp-3"><%= truncate(course.description, length: 120) %></p>
                
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center text-sm text-gray-500">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                    <span><%= course.instructor.display_name %></span>
                  </div>
                  <div class="flex items-center text-sm text-gray-500">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"></path>
                    </svg>
                    <span><%= course.enrollment_count %></span>
                  </div>
                </div>
                
                <div class="flex items-center justify-between">
                  <div class="text-lg font-bold text-gray-900">
                    <% if course.is_free? %>
                      <span class="text-green-600">Free</span>
                    <% else %>
                      $<%= course.price %>
                    <% end %>
                  </div>
                  <%= link_to course_path(course), class: "group flex items-center space-x-2 px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white text-sm font-medium rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all transform hover:scale-105 shadow-lg hover:shadow-xl" do %>
                    <span>View Course</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        
        <div class="mt-8 text-center">
          <%= link_to courses_path, class: "inline-flex items-center space-x-2 px-8 py-3 bg-gradient-to-r from-gray-900 to-gray-800 text-white font-medium rounded-xl hover:from-gray-800 hover:to-gray-700 transition-all transform hover:scale-105 shadow-lg" do %>
            <span>Explore All Courses</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
