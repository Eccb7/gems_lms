<% content_for :title, "Add New Instructor - Admin Dashboard" %>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Add New Instructor</h1>
          <p class="mt-2 text-gray-600">Create a new instructor account for the natural healing platform</p>
        </div>
        <%= link_to admin_users_path, class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors duration-200" do %>
          ← Back to Users
        <% end %>
      </div>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow p-8">
      <%= form_with model: [:admin, @user], local: true, class: "space-y-6" do |f| %>
        <%= render "shared/error_messages", resource: @user if @user.errors.any? %>

        <!-- Role Selection (Admin can choose any role) -->
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
          <h3 class="text-lg font-medium text-green-800 mb-3">Account Type</h3>
          <div>
            <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :role, 
                options_for_select([
                  ['Instructor - Teach natural healing courses', 'instructor'],
                  ['Student - Learn natural healing', 'student'],
                  ['Administrator - Full system access', 'admin']
                ], 'instructor'),
                {},
                { class: "w-full px-4 py-3 border border-green-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" } %>
          </div>
        </div>

        <!-- Personal Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :first_name, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_field :first_name, autofocus: true,
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                            placeholder: "First name" %>
          </div>
          <div>
            <%= f.label :last_name, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_field :last_name,
                            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                            placeholder: "Last name" %>
          </div>
        </div>

        <!-- Contact Information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.email_field :email, autocomplete: "email",
                              class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                              placeholder: "instructor@example.com" %>
          </div>
          <div>
            <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.telephone_field :phone,
                                 class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                                 placeholder: "Phone number (optional)" %>
          </div>
        </div>

        <!-- Date of Birth -->
        <div>
          <%= f.label :date_of_birth, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.date_field :date_of_birth,
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200" %>
        </div>

        <!-- Biography -->
        <div>
          <%= f.label :bio, "Professional Bio", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_area :bio, rows: 4,
                          class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                          placeholder: "Describe the instructor's background, expertise, and qualifications in natural healing..." %>
        </div>

        <!-- Password Section -->
        <div class="border-t border-gray-200 pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Account Security</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.password_field :password, autocomplete: "new-password",
                                   class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                                   placeholder: "Create a password" %>
              <p class="mt-1 text-sm text-gray-500">Minimum 6 characters</p>
            </div>
            <div>
              <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                   class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition duration-200",
                                   placeholder: "Confirm password" %>
            </div>
          </div>
        </div>

        <!-- Account Status -->
        <div class="flex items-center">
          <%= f.check_box :active, { checked: true, class: "h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" } %>
          <%= f.label :active, "Account Active", class: "ml-2 block text-sm text-gray-900" %>
          <p class="ml-6 text-sm text-gray-500">User can immediately sign in and access the platform</p>
        </div>

        <!-- Submit Button -->
        <div class="flex items-center justify-end space-x-4 pt-6 border-t border-gray-200">
          <%= link_to "Cancel", admin_users_path, 
              class: "px-6 py-3 bg-gray-100 text-gray-700 rounded-lg font-medium hover:bg-gray-200 transition-colors duration-200" %>
          <%= f.submit "Create Instructor Account", 
              class: "px-8 py-3 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 focus:ring-4 focus:ring-green-200 transition duration-200 transform hover:scale-[1.02]" %>
        </div>
      <% end %>
    </div>

    <!-- Help Text -->
    <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
      <h3 class="text-lg font-medium text-blue-800 mb-2">📋 Creating Instructor Accounts</h3>
      <ul class="text-sm text-blue-700 space-y-1">
        <li>• Instructors can create and manage their own courses</li>
        <li>• They can upload content, create assignments, and grade students</li>
        <li>• All instructors require admin approval before their courses go live</li>
        <li>• You can change user roles later if needed</li>
      </ul>
    </div>
  </div>
</div>
