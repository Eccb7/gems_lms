<% content_for :title, "User Management - Admin Dashboard" %>

<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">User Management</h1>
          <p class="mt-2 text-gray-600">Manage students, instructors, and administrators</p>
        </div>
        <div class="flex space-x-3">
          <%= link_to admin_dashboard_path, class: "px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors duration-200" do %>
            ← Back to Dashboard
          <% end %>
          <%= link_to new_admin_user_path, class: "px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200 font-medium" do %>
            + Add Instructor
          <% end %>
        </div>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white rounded-lg shadow p-6 mb-8">
      <%= form_with url: admin_users_path, method: :get, local: true, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <%= f.text_field :search, placeholder: "Search by name or email...", 
                value: params[:search],
                class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" %>
          </div>
          <div>
            <%= f.select :role, 
                options_for_select([
                  ['All Roles', ''],
                  ['Students', 'student'],
                  ['Instructors', 'instructor'],
                  ['Administrators', 'admin']
                ], params[:role]),
                {},
                { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500" } %>
          </div>
          <div class="flex space-x-2">
            <%= f.submit "Search", class: "px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors duration-200" %>
            <%= link_to "Clear", admin_users_path, class: "px-6 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors duration-200" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Joined</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stats</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @users.each do |user| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10">
                      <div class="h-10 w-10 rounded-full bg-gradient-to-r from-green-400 to-emerald-500 flex items-center justify-center">
                        <span class="text-white font-semibold text-sm">
                          <%= user.first_name&.first&.upcase %><%= user.last_name&.first&.upcase %>
                        </span>
                      </div>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= user.full_name %>
                      </div>
                      <div class="text-sm text-gray-500">
                        <%= user.email %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                    <%= case user.role
                        when 'admin' then 'bg-red-100 text-red-800'
                        when 'instructor' then 'bg-blue-100 text-blue-800'
                        else 'bg-green-100 text-green-800'
                        end %>">
                    <%= user.role.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                    <%= user.active? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                    <%= user.active? ? 'Active' : 'Inactive' %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= user.created_at.strftime("%b %d, %Y") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <% if user.instructor? %>
                    <%= pluralize(user.courses.count, 'course') %>
                  <% elsif user.student? %>
                    <%= pluralize(user.enrollments.count, 'enrollment') %>
                  <% else %>
                    Admin
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="flex items-center justify-end space-x-2">
                    <%= link_to "View", admin_user_path(user), 
                        class: "text-green-600 hover:text-green-900 text-sm" %>
                    <%= link_to "Edit", edit_admin_user_path(user), 
                        class: "text-blue-600 hover:text-blue-900 text-sm" %>
                    
                    <% if user.active? %>
                      <%= link_to "Deactivate", deactivate_admin_user_path(user), 
                          method: :patch,
                          class: "text-orange-600 hover:text-orange-900 text-sm",
                          confirm: "Are you sure you want to deactivate this user?" %>
                    <% else %>
                      <%= link_to "Activate", activate_admin_user_path(user), 
                          method: :patch,
                          class: "text-green-600 hover:text-green-900 text-sm" %>
                    <% end %>
                    
                    <% unless user == current_user %>
                      <%= link_to "Delete", admin_user_path(user), 
                          method: :delete,
                          class: "text-red-600 hover:text-red-900 text-sm",
                          confirm: "Are you sure you want to delete this user? This action cannot be undone." %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if @users.respond_to?(:current_page) %>
      <div class="flex justify-center mt-8">
        <div class="bg-white rounded-lg shadow p-6">
          <%= paginate @users %>
        </div>
      </div>
    <% end %>

    <!-- Summary Stats -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-2xl font-bold text-gray-900"><%= User.count %></div>
        <div class="text-sm text-gray-500">Total Users</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-2xl font-bold text-green-600"><%= User.student.count %></div>
        <div class="text-sm text-gray-500">Students</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-2xl font-bold text-blue-600"><%= User.instructor.count %></div>
        <div class="text-sm text-gray-500">Instructors</div>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <div class="text-2xl font-bold text-red-600"><%= User.admin.count %></div>
        <div class="text-sm text-gray-500">Administrators</div>
      </div>
    </div>
  </div>
</div>
