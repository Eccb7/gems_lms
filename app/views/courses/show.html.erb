<% content_for :title, "#{@course.title} - GEMS LMS" %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- Course Hero Section -->
  <div class="bg-gradient-to-r from-blue-900 to-purple-900 text-white rounded-lg overflow-hidden mb-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 p-8">
      <!-- Course Info -->
      <div class="lg:col-span-2">
        <!-- Breadcrumb -->
        <nav class="flex mb-4 text-blue-200" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
              <%= link_to root_path, class: "hover:text-white" do %>Home<% end %>
            </li>
            <li>
              <div class="flex items-center">
                <span class="mx-2">/</span>
                <%= link_to @course.category.name, category_path(@course.category), class: "hover:text-white" %>
              </div>
            </li>
            <li>
              <div class="flex items-center">
                <span class="mx-2">/</span>
                <span class="text-white"><%= truncate(@course.title, length: 50) %></span>
              </div>
            </li>
          </ol>
        </nav>

        <h1 class="text-4xl font-bold mb-4 leading-tight"><%= @course.title %></h1>
        <p class="text-xl text-blue-100 mb-6 leading-relaxed"><%= @course.description %></p>

        <!-- Course Stats -->
        <div class="flex flex-wrap items-center gap-6 mb-6">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-white font-semibold">4.8</span>
            <span class="text-blue-200 ml-1">(234 reviews)</span>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
            </svg>
            <span class="text-white"><%= @course.enrollments.count %> students</span>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-white"><%= @total_duration %> minutes</span>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <span class="text-white"><%= @total_lessons %> lessons</span>
          </div>
        </div>

        <!-- Course Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="px-3 py-1 bg-blue-700 bg-opacity-50 text-blue-100 text-sm rounded-full">
            <%= @course.category.name %>
          </span>
          <span class="px-3 py-1 bg-purple-700 bg-opacity-50 text-purple-100 text-sm rounded-full">
            <%= @course.difficulty_level.humanize %>
          </span>
          <% if @course.price == 0 %>
            <span class="px-3 py-1 bg-green-700 bg-opacity-50 text-green-100 text-sm rounded-full">
              Free
            </span>
          <% end %>
        </div>

        <!-- Instructor Info -->
        <div class="flex items-center space-x-4">
          <div class="w-12 h-12 bg-white bg-opacity-20 rounded-full flex items-center justify-center">
            <span class="text-white font-semibold"><%= @instructor.display_name.first(2).upcase %></span>
          </div>
          <div>
            <p class="text-white font-semibold"><%= @instructor.display_name %></p>
            <p class="text-blue-200 text-sm">Instructor</p>
          </div>
        </div>
      </div>

      <!-- Course Preview/Enrollment -->
      <div class="lg:col-span-1">
        <div class="bg-white bg-opacity-10 rounded-lg p-6 backdrop-blur-sm">
          <!-- Course Preview Image -->
          <div class="aspect-video bg-black bg-opacity-30 rounded-lg mb-6 flex items-center justify-center">
            <div class="text-center">
              <div class="w-16 h-16 mx-auto mb-4 bg-white bg-opacity-20 rounded-full flex items-center justify-center">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                </svg>
              </div>
              <p class="text-white text-sm">Course Preview</p>
            </div>
          </div>

          <!-- Price -->
          <div class="text-center mb-6">
            <% if @course.price > 0 %>
              <div class="text-3xl font-bold text-white mb-2">KES <%= number_with_delimiter(@course.price) %></div>
              <div class="text-blue-200 text-sm">One-time payment</div>
            <% else %>
              <div class="text-3xl font-bold text-green-300 mb-2">Free</div>
              <div class="text-blue-200 text-sm">No payment required</div>
            <% end %>
          </div>

          <!-- Enrollment Actions -->
          <% if user_signed_in? %>
            <% if @enrolled %>
              <!-- Already Enrolled -->
              <div class="space-y-3">
                <%= link_to "Continue Learning", student_course_path(@course), 
                           class: "block w-full text-center px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition" %>
                
                <% if @course_progress %>
                  <div class="text-center">
                    <p class="text-blue-200 text-sm mb-2">Your Progress</p>
                    <div class="w-full bg-white bg-opacity-20 rounded-full h-2">
                      <div class="bg-green-400 h-2 rounded-full" style="width: <%= @course_progress.progress_percentage %>%"></div>
                    </div>
                    <p class="text-white text-sm mt-1"><%= @course_progress.progress_percentage %>% complete</p>
                  </div>
                <% end %>
              </div>
            <% elsif current_user.student? %>
              <!-- Can Enroll -->
              <% if @course.is_free? %>
                <%= link_to "Enroll Now - Free", enroll_course_path(@course), method: :post,
                           class: "block w-full text-center px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition" %>
              <% else %>
                <!-- Paid Course - Show Payment Options -->
                <div class="space-y-3">
                  <!-- M-Pesa Payment Button -->
                  <button type="button" onclick="togglePaymentForm()" 
                          class="block w-full text-center px-6 py-3 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition">
                    <div class="flex items-center justify-center">
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18l9-5-9-5-9 5 9 5z"/>
                      </svg>
                      Pay with M-Pesa - KES <%= number_with_delimiter(@course.price) %>
                    </div>
                  </button>
                  
                  <!-- Payment Form (Hidden by default) -->
                  <div id="payment-form" class="hidden bg-white bg-opacity-10 rounded-lg p-4 backdrop-blur-sm">
                    <%= form_with model: [@course, Payment.new], url: course_payments_path(@course), local: true, class: "space-y-4" do |f| %>
                      <%= f.hidden_field :amount, value: @course.price %>
                      <%= f.hidden_field :payment_method, value: 'mpesa' %>
                      
                      <div>
                        <%= f.label :phone_number, "M-Pesa Phone Number", class: "block text-sm font-medium text-white mb-2" %>
                        <%= f.telephone_field :phone_number, 
                                              placeholder: "e.g., 0712345678", 
                                              class: "w-full px-3 py-2 bg-white bg-opacity-20 border border-white border-opacity-30 rounded-lg text-white placeholder-blue-200 focus:ring-2 focus:ring-green-400 focus:border-transparent",
                                              pattern: "[0-9]{10}",
                                              required: true %>
                        <p class="text-blue-200 text-xs mt-1">Enter your M-Pesa registered phone number</p>
                      </div>
                      
                      <%= f.submit "Proceed to Pay", 
                                   class: "w-full bg-green-600 text-white py-2 px-4 rounded-lg font-semibold hover:bg-green-700 transition duration-200" %>
                    <% end %>
                    
                    <button type="button" onclick="togglePaymentForm()" 
                            class="w-full mt-2 text-blue-200 hover:text-white text-sm">
                      Cancel
                    </button>
                  </div>
                </div>
              <% end %>
            <% else %>
              <!-- Instructor/Admin View -->
              <div class="text-center text-blue-200 text-sm">
                <p>Viewing as <%= current_user.role.humanize %></p>
              </div>
            <% end %>
          <% else %>
            <!-- Not Signed In -->
            <div class="space-y-3">
              <%= link_to "Sign Up to Enroll", new_user_registration_path, 
                         class: "block w-full text-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition" %>
              <%= link_to "Sign In", new_user_session_path, 
                         class: "block w-full text-center px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-blue-900 transition" %>
            </div>
          <% end %>

          <!-- Course Includes -->
          <div class="mt-6 pt-6 border-t border-white border-opacity-20">
            <h4 class="text-white font-semibold mb-3">This course includes:</h4>
            <ul class="space-y-2 text-blue-100 text-sm">
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <%= @total_lessons %> video lessons
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Downloadable resources
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Lifetime access
              </li>
              <li class="flex items-center">
                <svg class="w-4 h-4 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Certificate of completion
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Course Content Tabs -->
  <div class="bg-white rounded-lg shadow">
    <!-- Tab Navigation -->
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8 px-6" aria-label="Tabs">
        <button class="course-tab-button active border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="overview">
          Overview
        </button>
        <button class="course-tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="curriculum">
          Curriculum
        </button>
        <button class="course-tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="instructor">
          Instructor
        </button>
        <button class="course-tab-button border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" data-tab="reviews">
          Reviews
        </button>
      </nav>
    </div>

    <!-- Tab Content -->
    <div class="p-6">
      <!-- Overview Tab -->
      <div id="overview-tab" class="course-tab-content">
        <div class="prose max-w-none">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">What you'll learn</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
            <% learning_objectives = [
              "Master the fundamentals of #{@course.category.name}",
              "Apply practical skills in real-world scenarios",
              "Build confidence through hands-on projects",
              "Understand advanced concepts and best practices"
            ] %>
            <% learning_objectives.each do |objective| %>
              <div class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-gray-700"><%= objective %></span>
              </div>
            <% end %>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">Course Description</h3>
          <div class="text-gray-700 leading-relaxed mb-8">
            <%= simple_format(@course.description) %>
          </div>

          <h3 class="text-2xl font-bold text-gray-900 mb-4">Requirements</h3>
          <ul class="list-disc list-inside text-gray-700 space-y-2 mb-8">
            <li>Basic computer skills and internet access</li>
            <li>Motivation to learn and practice</li>
            <li>No prior experience in <%= @course.category.name.downcase %> required</li>
          </ul>
        </div>
      </div>

      <!-- Curriculum Tab -->
      <div id="curriculum-tab" class="course-tab-content hidden">
        <div class="space-y-6">
          <div class="flex justify-between items-center">
            <h3 class="text-2xl font-bold text-gray-900">Course Curriculum</h3>
            <div class="text-gray-600 text-sm">
              <%= @sections.count %> sections • <%= @total_lessons %> lessons • <%= @total_duration %> min total length
            </div>
          </div>

          <!-- Course Sections -->
          <div class="space-y-4">
            <% @sections.each_with_index do |section, index| %>
              <div class="border border-gray-200 rounded-lg">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
                  <div class="flex justify-between items-center">
                    <h4 class="text-lg font-semibold text-gray-900">
                      Section <%= index + 1 %>: <%= section.title %>
                    </h4>
                    <div class="text-sm text-gray-600">
                      <%= section.lessons.count %> lessons
                    </div>
                  </div>
                  <% if section.description.present? %>
                    <p class="text-gray-600 mt-2"><%= section.description %></p>
                  <% end %>
                </div>

                <!-- Section Lessons -->
                <div class="divide-y divide-gray-200">
                  <% section.lessons.order(:position).each_with_index do |lesson, lesson_index| %>
                    <div class="px-6 py-4 hover:bg-gray-50 transition">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                          <!-- Lesson Icon -->
                          <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                            <% case lesson.lesson_type %>
                            <% when 'video' %>
                              <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                              </svg>
                            <% when 'text' %>
                              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                              </svg>
                            <% when 'quiz' %>
                              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                              </svg>
                            <% when 'assignment' %>
                              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                              </svg>
                            <% end %>
                          </div>

                          <!-- Lesson Info -->
                          <div>
                            <h5 class="font-medium text-gray-900">
                              <%= lesson_index + 1 %>. <%= lesson.title %>
                            </h5>
                            <div class="flex items-center space-x-4 text-sm text-gray-600 mt-1">
                              <span class="capitalize"><%= lesson.lesson_type %></span>
                              <% if lesson.duration.present? %>
                                <span><%= lesson.duration %> min</span>
                              <% end %>
                            </div>
                          </div>
                        </div>

                        <!-- Preview/Lock -->
                        <div class="flex items-center">
                          <% if @enrollment %>
                            <span class="text-green-600 text-sm">Available</span>
                          <% else %>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Instructor Tab -->
      <div id="instructor-tab" class="course-tab-content hidden">
        <div class="max-w-4xl">
          <div class="flex items-start space-x-6 mb-8">
            <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center">
              <span class="text-2xl font-bold text-gray-600"><%= @instructor.display_name.first(2).upcase %></span>
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-gray-900 mb-2"><%= @instructor.display_name %></h3>
              <p class="text-gray-600 mb-4"><%= @instructor.title || "Instructor" %></p>
              
              <div class="grid grid-cols-3 gap-4 mb-6">
                <div>
                  <div class="text-2xl font-bold text-gray-900"><%= @instructor.courses.published.count %></div>
                  <div class="text-gray-600 text-sm">Courses</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-gray-900"><%= Enrollment.joins(:course).where(courses: { instructor: @instructor }).count %></div>
                  <div class="text-gray-600 text-sm">Students</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-gray-900">4.9</div>
                  <div class="text-gray-600 text-sm">Rating</div>
                </div>
              </div>
            </div>
          </div>

          <div class="prose max-w-none">
            <h4 class="text-xl font-semibold text-gray-900 mb-3">About the Instructor</h4>
            <% if @instructor.bio.present? %>
              <p class="text-gray-700 leading-relaxed"><%= simple_format(@instructor.bio) %></p>
            <% else %>
              <p class="text-gray-700 leading-relaxed">
                <%= @instructor.display_name %> is an experienced instructor passionate about teaching <%= @course.category.name.downcase %>. 
                With years of industry experience, they bring practical knowledge and real-world insights to every lesson.
              </p>
            <% end %>
          </div>

          <!-- Other Courses by Instructor -->
          <% other_courses = @instructor.courses.published.where.not(id: @course.id).limit(3) %>
          <% if other_courses.any? %>
            <div class="mt-8">
              <h4 class="text-xl font-semibold text-gray-900 mb-4">More courses by <%= @instructor.display_name %></h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <% other_courses.each do |course| %>
                  <div class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition">
                    <div class="h-32 bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center">
                      <span class="text-white font-semibold"><%= course.title.first(2).upcase %></span>
                    </div>
                    <div class="p-4">
                      <h5 class="font-semibold text-gray-900 mb-2 line-clamp-2"><%= course.title %></h5>
                      <div class="flex justify-between items-center">
                        <span class="text-sm text-gray-600"><%= course.category.name %></span>
                        <%= link_to "View Course", course_path(course), class: "text-blue-600 hover:text-blue-800 text-sm" %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Reviews Tab -->
      <div id="reviews-tab" class="course-tab-content hidden">
        <div class="max-w-4xl">
          <!-- Reviews Summary -->
          <div class="flex items-center space-x-8 mb-8 p-6 bg-gray-50 rounded-lg">
            <div class="text-center">
              <div class="text-4xl font-bold text-gray-900">4.8</div>
              <div class="flex items-center justify-center mt-1">
                <% 5.times do |i| %>
                  <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% end %>
              </div>
              <div class="text-gray-600 text-sm mt-1">Course Rating</div>
            </div>
            
            <div class="flex-1">
              <div class="space-y-2">
                <% [5, 4, 3, 2, 1].each do |rating| %>
                  <div class="flex items-center">
                    <span class="text-sm font-medium text-gray-700 w-8"><%= rating %>★</span>
                    <div class="w-full bg-gray-200 rounded-full h-2 mx-3">
                      <div class="bg-yellow-400 h-2 rounded-full" style="width: <%= rating == 5 ? 70 : rating == 4 ? 20 : 5 %>%"></div>
                    </div>
                    <span class="text-sm text-gray-600 w-12"><%= rating == 5 ? "70%" : rating == 4 ? "20%" : "5%" %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Individual Reviews -->
          <div class="space-y-6">
            <% sample_reviews = [
              { name: "Sarah Johnson", rating: 5, date: "2 weeks ago", comment: "Excellent course! The instructor explains everything clearly and the hands-on projects really helped me understand the concepts." },
              { name: "Michael Chen", rating: 5, date: "1 month ago", comment: "I was a complete beginner and this course took me from zero to confident. Highly recommend!" },
              { name: "Emma Wilson", rating: 4, date: "1 month ago", comment: "Great content and well organized. Would love to see more advanced topics covered in a follow-up course." }
            ] %>
            
            <% sample_reviews.each do |review| %>
              <div class="border-b border-gray-200 pb-6">
                <div class="flex items-start space-x-4">
                  <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center">
                    <span class="text-sm font-medium text-gray-600"><%= review[:name].split.map(&:first).join %></span>
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center space-x-2 mb-2">
                      <span class="font-medium text-gray-900"><%= review[:name] %></span>
                      <div class="flex items-center">
                        <% review[:rating].times do %>
                          <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                          </svg>
                        <% end %>
                      </div>
                      <span class="text-gray-500 text-sm"><%= review[:date] %></span>
                    </div>
                    <p class="text-gray-700"><%= review[:comment] %></p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Similar Courses -->
  <% if @similar_courses.any? %>
    <div class="mt-12">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">You might also like</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <% @similar_courses.each do |course| %>
          <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
            <div class="h-32 bg-gradient-to-r from-blue-500 to-purple-600 flex items-center justify-center">
              <span class="text-white font-semibold"><%= course.title.first(2).upcase %></span>
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2"><%= course.title %></h3>
              <p class="text-sm text-gray-600 mb-2">by <%= course.instructor.display_name %></p>
              <div class="flex justify-between items-center">
                <span class="font-semibold text-green-600">
                  <% if course.price > 0 %>$<%= course.price %><% else %>Free<% end %>
                </span>
                <%= link_to "View", course_path(course), class: "text-blue-600 hover:text-blue-800 text-sm" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Tab JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabButtons = document.querySelectorAll('.course-tab-button');
  const tabContents = document.querySelectorAll('.course-tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const targetTab = button.getAttribute('data-tab');

      // Remove active classes from all buttons and contents
      tabButtons.forEach(btn => {
        btn.classList.remove('active', 'border-blue-500', 'text-blue-600');
        btn.classList.add('border-transparent', 'text-gray-500');
      });
      
      tabContents.forEach(content => {
        content.classList.add('hidden');
      });

      // Add active classes to clicked button and show corresponding content
      button.classList.add('active', 'border-blue-500', 'text-blue-600');
      button.classList.remove('border-transparent', 'text-gray-500');
      
      document.getElementById(targetTab + '-tab').classList.remove('hidden');
    });
  });
  
  // Payment form toggle function
  function togglePaymentForm() {
    const paymentForm = document.getElementById('payment-form');
    if (paymentForm.classList.contains('hidden')) {
      paymentForm.classList.remove('hidden');
    } else {
      paymentForm.classList.add('hidden');
    }
  }
});
</script>
